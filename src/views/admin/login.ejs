<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Restricted Admin Portal | Cosmic Finance</title>
  <meta name="robots" content="noindex, nofollow, noarchive">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-login-body">
  <div class="admin-login-card">
    <div class="admin-header text-center">
      <span class="admin-lock-icon">🔒</span>
      <h2>Cosmic Finance Portal</h2>
      <p class="admin-subtext">Restricted Single-Administrator Security Gateway</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert-danger"><%= error %></div>
    <% } %>

    <form action="<%= adminPath %>/login" method="POST" class="cosmic-form" id="adminLoginForm">
      <div class="form-group">
        <label for="username">Admin Username</label>
        <input type="text" id="username" name="username" class="form-control" autocomplete="username" required>
      </div>

      <div class="form-group">
        <label for="password">Master Password</label>
        <input type="password" id="password" name="password" class="form-control" autocomplete="current-password" required>
      </div>

      <div class="form-group">
        <label for="totpToken">Two-Factor Authenticator Code (TOTP)</label>
        <input type="text" id="totpToken" name="totpToken" class="form-control" placeholder="6-digit authenticator code" pattern="[0-9]{6}" autocomplete="one-time-code" required>
        <small class="field-hint">Open your Google Authenticator or 2FA app to obtain code.</small>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-gold btn-block btn-lg">
          Authenticate & Enter Portal &rarr;
        </button>
      </div>
    </form>

    <div class="admin-security-footer">
      <span>IP Logging & Rate-Limiting Active</span>
      <span>•</span>
      <span>Session Strict Isolation</span>
    </div>
  </div>
</body>
</html>
