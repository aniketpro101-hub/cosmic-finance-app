<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Article Moderation | Cosmic Finance Admin</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-dashboard-body">
  <div class="admin-layout">
    <aside class="admin-sidebar">
      <div class="sidebar-brand"><span class="logo-symbol">✦</span> Cosmic Admin</div>
      <nav class="sidebar-nav">
        <a href="<%= adminPath %>" class="sidebar-link">📊 Control Deck</a>
        <a href="<%= adminPath %>/thoughts" class="sidebar-link">✍️ Daily Thoughts</a>
        <a href="<%= adminPath %>/articles" class="sidebar-link active">📚 Article Review</a>
        <a href="<%= adminPath %>/news" class="sidebar-link">📰 Curated News</a>
        <a href="<%= adminPath %>/leads" class="sidebar-link">🎯 Kundli Leads</a>
        <a href="<%= adminPath %>/analytics" class="sidebar-link">📈 Analytics</a>
      </nav>
      <div class="sidebar-footer"><a href="<%= adminPath %>/logout" class="sidebar-logout">Logout &rarr;</a></div>
    </aside>

    <main class="admin-main">
      <header class="admin-topbar">
        <h2>Article Review & Publishing Center</h2>
      </header>

      <div class="admin-content-inner">
        <!-- Direct Create Article Form -->
        <div class="admin-panel mb-6">
          <h3>Compose & Publish New Article</h3>
          <p class="text-muted">Draft research papers, case studies, or educational guides for immediate publication.</p>
          <form action="<%= adminPath %>/articles/create" method="POST" class="cosmic-form">
            <div class="form-group">
              <label for="title">Article Title</label>
              <input type="text" id="title" name="title" class="form-control" placeholder="e.g. Mercury Retrograde and Intraday Volatility Patterns in NIFTY" required>
            </div>
            <div class="form-row">
              <div class="form-group col-half">
                <label for="category">Category</label>
                <select id="category" name="category" class="form-control">
                  <option value="Basics">Basics & Fundamentals</option>
                  <option value="Market Timing">Market Timing & Cycles</option>
                  <option value="Psychology">Trader Psychology</option>
                  <option value="Asset Classes">Asset Classes & Sectors</option>
                </select>
              </div>
              <div class="form-group col-half">
                <label for="readTime">Read Time</label>
                <input type="text" id="readTime" name="readTime" class="form-control" value="6 min read">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group col-half">
                <label for="authorName">Author Name</label>
                <input type="text" id="authorName" name="authorName" class="form-control" value="Cosmic Finance Research Desk">
              </div>
              <div class="form-group col-half">
                <label for="authorBio">Author Credentials</label>
                <input type="text" id="authorBio" name="authorBio" class="form-control" value="Senior Financial Astrologer">
              </div>
            </div>
            <div class="form-group">
              <label for="excerpt">Executive Excerpt / Teaser</label>
              <textarea id="excerpt" name="excerpt" class="form-control" rows="2" placeholder="Brief summary displayed on articles index card..." required></textarea>
            </div>
            <div class="form-group">
              <label for="content">Full Article Body (Markdown / Plain Text)</label>
              <textarea id="content" name="content" class="form-control" rows="10" placeholder="Full body content of the article..." required></textarea>
            </div>
            <button type="submit" class="btn btn-gold">Publish Article to Public Library</button>
          </form>
        </div>

        <!-- Moderation Queue -->
        <div class="admin-panel mb-6">
          <h3>Pending Community Submissions (<%= pending.length %>)</h3>
          <% if (pending && pending.length) { %>
            <div class="pending-articles-queue">
              <% pending.forEach(function(art) { %>
                <div class="moderation-card">
                  <div class="moderation-meta">
                    <span class="pill-badge"><%= art.category %></span>
                    <span>Submitted by: <strong><%= art.author_name %></strong></span>
                    <span><%= new Date(art.created_at).toLocaleDateString('en-IN') %></span>
                  </div>
                  <h4 class="moderation-title"><%= art.title %></h4>
                  <p class="moderation-excerpt"><%= art.excerpt %></p>
                  <div class="moderation-full-content">
                    <p><%= art.content %></p>
                  </div>
                  <div class="moderation-actions">
                    <form action="<%= adminPath %>/articles/moderate" method="POST" class="d-inline">
                      <input type="hidden" name="articleId" value="<%= art.id %>">
                      <input type="hidden" name="action" value="approve">
                      <button type="submit" class="btn btn-gold btn-sm">Approve & Publish Live</button>
                    </form>
                    <form action="<%= adminPath %>/articles/moderate" method="POST" class="d-inline">
                      <input type="hidden" name="articleId" value="<%= art.id %>">
                      <input type="hidden" name="action" value="reject">
                      <input type="text" name="rejectionNote" placeholder="Rejection reason..." class="form-control form-control-sm d-inline w-auto">
                      <button type="submit" class="btn btn-outline btn-sm">Reject</button>
                    </form>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p class="text-muted py-4">No pending submissions in the queue.</p>
          <% } %>
        </div>

        <!-- Approved Articles -->
        <div class="admin-panel">
          <h3>Published Live Articles (<%= approved.length %>)</h3>
          <div class="table-responsive">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Title</th>
                  <th>Author</th>
                  <th>Category</th>
                  <th>Published Date</th>
                </tr>
              </thead>
              <tbody>
                <% if (approved && approved.length) { %>
                  <% approved.forEach(function(art) { %>
                    <tr>
                      <td><a href="/articles/<%= art.slug %>" target="_blank" class="text-gold"><%= art.title %></a></td>
                      <td><%= art.author_name %></td>
                      <td><%= art.category %></td>
                      <td><%= new Date(art.published_at || art.created_at).toLocaleDateString('en-IN') %></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr><td colspan="4" class="text-center text-muted">No published articles yet.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
