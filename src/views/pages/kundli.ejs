<div class="page-container container section-rhythm kundli-royal-light-page">
  <header class="page-header text-center">
    <div class="cosmic-badge">
      <span class="pulsing-star">✦</span>
      <span>VEDIC MULTI-ASSET ASTRONOMY &amp; NUMEROLOGY</span>
    </div>
    <h1 class="page-title">Enter Your <span class="text-gold">Birth Coordinates</span></h1>
    <p class="page-subtitle">
      Decode how planetary transits, Nakshatra movements, and Vedic numerology impact your personal financial destiny, speculation instincts, and wealth cycles across multi-asset classes.
    </p>
  </header>

  <div class="kundli-funnel-wrapper" id="kundliFunnel">
    <!-- Step 1: Input Form (Aligned with Classical Kundli Specifications) -->
    <div class="kundli-card" id="kundliFormCard">
      <div class="kundli-card-header">
        <h2>Enter Your Birth Coordinates</h2>
        <p>Your birth details remain 100% confidential and encrypted under military-grade AES-256 standards.</p>
      </div>

      <form id="tradingKundliForm" class="cosmic-form" novalidate>
        <!-- Row 1: Name & Gender Toggle -->
        <div class="form-row-split">
          <div class="form-group flex-2">
            <label for="fullName">Full Name <span class="required">*</span></label>
            <input type="text" id="fullName" name="fullName" class="form-control" placeholder="Enter Full Name" required>
            <span class="field-error" id="nameError"></span>
          </div>

          <div class="form-group flex-1">
            <label>Gender <span class="required">*</span></label>
            <div class="gender-toggle-group">
              <button type="button" class="gender-btn active" data-gender="Male" id="btnGenderMale">Male</button>
              <button type="button" class="gender-btn" data-gender="Female" id="btnGenderFemale">Female</button>
            </div>
            <input type="hidden" id="genderInput" name="gender" value="Male">
          </div>
        </div>

        <!-- Row 2: Date of Birth (Day / Month / Year) -->
        <div class="form-row-three">
          <div class="form-group">
            <label for="birthDay">Day <span class="required">*</span></label>
            <input type="number" id="birthDay" name="day" class="form-control" placeholder="DD" min="1" max="31" value="15" required>
            <span class="field-error" id="dayError"></span>
          </div>
          <div class="form-group">
            <label for="birthMonth">Month <span class="required">*</span></label>
            <input type="number" id="birthMonth" name="month" class="form-control" placeholder="MM" min="1" max="12" value="1" required>
            <span class="field-error" id="monthError"></span>
          </div>
          <div class="form-group">
            <label for="birthYear">Year <span class="required">*</span></label>
            <input type="number" id="birthYear" name="year" class="form-control" placeholder="YYYY" min="1930" max="2026" value="1995" required>
            <span class="field-error" id="yearError"></span>
          </div>
        </div>

        <!-- Row 3: Time of Birth (Hrs / Min / Sec) -->
        <div class="form-row-three">
          <div class="form-group">
            <label for="birthHrs">Hrs (0-23)</label>
            <input type="number" id="birthHrs" name="hrs" class="form-control" placeholder="Hours" min="0" max="23" value="12">
          </div>
          <div class="form-group">
            <label for="birthMin">Min (0-59)</label>
            <input type="number" id="birthMin" name="min" class="form-control" placeholder="Minute" min="0" max="59" value="00">
          </div>
          <div class="form-group">
            <label for="birthSec">Sec (0-59)</label>
            <input type="number" id="birthSec" name="sec" class="form-control" placeholder="Second" min="0" max="59" value="00">
          </div>
        </div>

        <!-- Row 4: Place of Birth + Quick Buttons -->
        <div class="form-group">
          <div class="label-with-actions">
            <label for="pob">Place of Birth <span class="required">*</span></label>
            <div class="quick-location-actions">
              <button type="button" class="btn-quick-text" id="btnCurrentLocation">
                <span>📍 CURRENT LOCATION</span>
              </button>
              <button type="button" class="btn-quick-text text-gold" id="btnSetNow">
                <span>⚡ NOW</span>
              </button>
            </div>
          </div>
          <div class="pob-input-wrapper">
            <input type="text" id="pob" name="pob" class="form-control pob-autocomplete-input" autocomplete="off" placeholder="Type ANY city worldwide (e.g. Gaya, Jaipur, Dubai, London, Patna)" value="Mumbai, Maharashtra" required>
            <input type="hidden" id="pobLat" name="lat" value="19.0760">
            <input type="hidden" id="pobLng" name="lng" value="72.8777">
            <ul id="cityAutocompleteDropdown" class="city-autocomplete-dropdown" style="display:none;" role="listbox"></ul>
          </div>
          <span class="field-error" id="pobError"></span>
        </div>

        <!-- Advanced Settings Toggle Trigger (Starts Minimized by Default) -->
        <div class="advanced-settings-bar">
          <button type="button" class="btn-toggle-settings" id="btnToggleSettings" aria-expanded="false">
            <span id="settingsIcon">[+]</span> SETTINGS
          </button>
          <span class="settings-hint">GPS coordinates, Ayanamsha &amp; Chart Style (Optional)</span>
        </div>

        <!-- Collapsible Advanced Settings Drawer (Hidden by default everywhere) -->
        <div class="advanced-settings-drawer hidden" id="advancedSettingsDrawer" style="display: none;">
          <div class="advanced-settings-box">
            <div class="adv-header">
              <h3>Advanced Astronomical Settings</h3>
              <span class="gps-badge">GPS Precision High</span>
            </div>

            <div class="form-row-three">
              <div class="form-group">
                <label for="longDeg">LongDeg</label>
                <input type="number" id="longDeg" name="longDeg" class="form-control" placeholder="72" value="72">
              </div>
              <div class="form-group">
                <label for="longMin">LongMin</label>
                <input type="number" id="longMin" name="longMin" class="form-control" placeholder="52" value="52">
              </div>
              <div class="form-group">
                <label for="longEW">LongEW</label>
                <select id="longEW" name="longEW" class="form-control">
                  <option value="E" selected>East (E)</option>
                  <option value="W">West (W)</option>
                </select>
              </div>
            </div>

            <div class="form-row-three">
              <div class="form-group">
                <label for="latDeg">LatDeg</label>
                <input type="number" id="latDeg" name="latDeg" class="form-control" placeholder="18" value="18">
              </div>
              <div class="form-group">
                <label for="latMin">LatMin</label>
                <input type="number" id="latMin" name="latMin" class="form-control" placeholder="58" value="58">
              </div>
              <div class="form-group">
                <label for="latNS">LatNS</label>
                <select id="latNS" name="latNS" class="form-control">
                  <option value="N" selected>North (N)</option>
                  <option value="S">South (S)</option>
                </select>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group col-half">
                <label for="timeZone">Time Zone</label>
                <input type="text" id="timeZone" name="timeZone" class="form-control" value="+05:30 (Asia/Kolkata)">
              </div>
              <div class="form-group col-half">
                <label for="ayanamsaSelect">Ayanamsa</label>
                <select id="ayanamsaSelect" name="ayanamsa" class="form-control">
                  <option value="N.C.Lahiri" selected>N.C. Lahiri (Chitra Paksha)</option>
                  <option value="Raman">B.V. Raman</option>
                  <option value="KP">KP (Krishnamurti Paddhati)</option>
                  <option value="TrueChitra">True Chitra Sidereal</option>
                </select>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group col-half">
                <label for="chartStyleSelect">Chart Style</label>
                <select id="chartStyleSelect" name="chartStyle" class="form-control">
                  <option value="North Indian" selected>North Indian (Diamond Chakra)</option>
                  <option value="South Indian">South Indian (Square Box)</option>
                </select>
              </div>
              <div class="form-group col-half">
                <div class="label-with-actions">
                  <label for="horaryNumber">KP Horary Number (1-249)</label>
                  <button type="button" class="btn-text-link" id="btnRandomKP">Random KP Number</button>
                </div>
                <input type="number" id="horaryNumber" name="horaryNumber" class="form-control" placeholder="e.g. 170" min="1" max="249">
              </div>
            </div>
          </div>
        </div>

        <!-- Privacy & Submission -->
        <div class="form-group checkbox-group" style="margin-top: 14px;">
          <label class="consent-label">
            <input type="checkbox" id="privacyConsent" name="privacyConsent" checked required>
            <span>I consent to having my birth details calculated for Vedic financial astrological analysis under strict confidentiality.</span>
          </label>
          <span class="field-error" id="consentError"></span>
        </div>

        <div class="form-actions text-center" style="margin-top: 18px;">
          <button type="submit" class="btn btn-show-kundli" id="btnCalculateKundli">
            <span>SHOW KUNDLI</span>
          </button>
        </div>
      </form>
    </div>

    <!-- Processing State (Ceremonial Celestial Animation) -->
    <div class="kundli-processing-state" id="kundliProcessingState" style="display: none;">
      <div class="celestial-spinner">
        <div class="orbit-ring ring-1"></div>
        <div class="orbit-ring ring-2"></div>
        <div class="celestial-core">✦</div>
      </div>
      <h3>Calculating Natal Ephemeris...</h3>
      <p>Plotting 12 Bhavas, planetary dignities, and financial speculation yogas</p>
    </div>

    <!-- Step 2: Instant Impressive Kundli Display Result -->
    <div class="kundli-result-card" id="kundliResultCard" style="display: none;">
      <!-- Result Top Header -->
      <div class="result-header-luxury">
        <div class="result-header-left">
          <span class="result-badge-gold">✦ VEDIC FINANCIAL HOROSCOPE</span>
          <h2 id="resultUserName">Analysis for Vikram</h2>
          <div class="result-meta-line" id="resultMetaLine">
            <span>📅 15-Jan-1994 &bull; 12:00 PM</span>
            <span>📍 Mumbai, Maharashtra</span>
            <span>🪐 Ascendant: Aries (Mesha)</span>
          </div>
        </div>
        <div class="result-header-right">
          <div class="chart-switch-pills">
            <button type="button" class="chart-pill active" id="btnChartStyleNorth">North Indian</button>
            <button type="button" class="chart-pill" id="btnChartStyleSouth">South Indian</button>
          </div>
        </div>
      </div>

      <!-- EXECUTIVE ACTION TOOLBAR: 3 PRIMARY ACTION BUTTONS -->
      <div class="kundli-action-toolbar">
        <button type="button" class="btn-dossier-action btn-dossier-download" id="btnDownloadDossierPdf">
          <span class="action-icon">📥</span>
          <div class="action-texts">
            <span class="action-primary">Download Wealth Dossier (PDF)</span>
            <span class="action-secondary">Institutional 5-Page Report • D1, D9, D10, D2 &amp; Ashtakavarga</span>
          </div>
        </button>

        <button type="button" class="btn-dossier-action btn-dossier-print" id="btnPrintDossier">
          <span class="action-icon">🖨️</span>
          <div class="action-texts">
            <span class="action-primary">Print Dossier</span>
            <span class="action-secondary">Direct A4 Printable Output</span>
          </div>
        </button>

        <a href="https://wa.me/<%= founder.whatsappNumber %>?text=<%= encodeURIComponent(whatsappMessage) %>" target="_blank" rel="noopener" class="btn-dossier-action btn-dossier-consult" id="btnUnlockFutureCta">
          <span class="action-icon">👑</span>
          <div class="action-texts">
            <span class="action-primary">Unlock Financial Future</span>
            <span class="action-secondary">VIP Guidance with Dr. Ashish Patni</span>
          </div>
        </a>
      </div>

      <!-- Live Status & Hidden Download Form -->
      <div id="pdfDownloadNotice" class="pdf-download-notice" style="display: none;">
        <span class="notice-spinner">⏳</span>
        <span id="pdfNoticeText">Compiling institutional 5-page PDF dossier... Please wait a few seconds.</span>
      </div>

      <form id="pdfExportForm" method="POST" action="/api/kundli/pdf" target="_blank" style="display: none;">
        <input type="hidden" name="analysis" id="pdfAnalysisInput">
      </form>

      <!-- Main Visual Birth Chart Container -->
      <div class="kundli-charts-row">
        <!-- North Indian Diamond Chart -->
        <div class="chakra-card-box" id="chartViewNorth">
          <div class="chakra-title-bar">
            <span>Lagna Kundli (D1 Canonical Parashari)</span>
            <span class="tag-gold">Geocentric Sidereal • Lahiri</span>
          </div>
          <div class="vedic-chakra-visual" id="northIndianChartContainer">
            <!-- Dynamically populated with full vector SVG -->
          </div>
        </div>

        <!-- South Indian Square Chart View (Toggleable) -->
        <div class="chakra-card-box hidden" id="chartViewSouth">
          <div class="chakra-title-bar">
            <span>South Indian Natal Chart</span>
            <span class="tag-gold">Fixed Sign Matrix</span>
          </div>
          <div class="south-indian-grid" id="southIndianGrid">
            <!-- Populated via JavaScript -->
          </div>
        </div>

        <!-- 4 Key Financial Houses Breakdown Card -->
        <div class="financial-houses-panel">
          <div class="panel-header-gold">
            <span>🏛️ Four Pillars of Financial Astrology</span>
            <span class="badge-gold-subtle">Wealth Matrix</span>
          </div>

          <div class="financial-pillars-list">
            <!-- 2nd House -->
            <div class="pillar-row">
              <div class="pillar-label">
                <span class="pillar-num gold">2nd</span>
                <div>
                  <strong>Dhana Bhava (Liquid Wealth)</strong>
                  <span class="pillar-sign" id="h2SignDisplay">Taurus (Venus)</span>
                </div>
              </div>
              <p class="pillar-impact" id="h2ImpactText">Liquid treasury, bank balances, capital compounding capacity.</p>
            </div>

            <!-- 5th House -->
            <div class="pillar-row highlight-gold">
              <div class="pillar-label">
                <span class="pillar-num gold-glow">5th</span>
                <div>
                  <strong>Purva Punya &amp; Speculation (Multi-Asset Allocation)</strong>
                  <span class="pillar-sign" id="h5SignDisplay">Leo (Sun)</span>
                </div>
              </div>
              <p class="pillar-impact" id="h5ImpactText">Financial instinct, multi-asset allocation acumen, and timing intuition.</p>
            </div>

            <!-- 9th House -->
            <div class="pillar-row">
              <div class="pillar-label">
                <span class="pillar-num violet">9th</span>
                <div>
                  <strong>Bhagya Bhava (Fortune &amp; Luck)</strong>
                  <span class="pillar-sign" id="h9SignDisplay">Sagittarius (Jupiter)</span>
                </div>
              </div>
              <p class="pillar-impact" id="h9ImpactText">Macro market tailwinds, windfall luck, and generational wealth timing.</p>
            </div>

            <!-- 11th House -->
            <div class="pillar-row">
              <div class="pillar-label">
                <span class="pillar-num green">11th</span>
                <div>
                  <strong>Labha Bhava (Realized Gains &amp; Profits)</strong>
                  <span class="pillar-sign" id="h11SignDisplay">Aquarius (Saturn)</span>
                </div>
              </div>
              <p class="pillar-impact" id="h11ImpactText">Profit booking velocity, multi-bagger returns, and net worth expansion.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Complete Planetary Positions Matrix Table -->
      <div class="planetary-positions-card">
        <div class="table-header-row">
          <h3>Natal Planetary Longitudes &amp; Dignities</h3>
          <span class="table-legend">Calculated via High-Precision Sidereal Ephemeris</span>
        </div>
        <div class="table-responsive">
          <table class="cosmic-table" id="planetaryTable">
            <thead>
              <tr>
                <th>Planet (Graha)</th>
                <th>Glyph</th>
                <th>Rashi (Sign)</th>
                <th>Degree</th>
                <th>Nakshatra</th>
                <th>Pada</th>
                <th>House</th>
                <th>Motion</th>
                <th>Dignity</th>
              </tr>
            </thead>
            <tbody id="planetaryTableBody">
              <!-- Rendered dynamically -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Speculation & Trading Personality Summary -->
      <div class="result-metrics-grid">
        <div class="result-metric-box">
          <span class="metric-label">Speculation Yoga (5th Bhava)</span>
          <span class="metric-value highlight" id="speculationScore">Strong (Uchha)</span>
          <p class="metric-desc" id="speculationDesc">Benefic aspect on the 5th lord indicates natural instinct for disciplined calculation over irrational impulse.</p>
        </div>
        <div class="result-metric-box">
          <span class="metric-label">Trading Personality Archetype</span>
          <span class="metric-value" id="personalityArchetype">Calculated Strategist</span>
          <p class="metric-desc" id="personalityDesc">Thrives in structured setups; gains compound through swing timeframe patience rather than intraday scalping.</p>
        </div>
        <div class="result-metric-box">
          <span class="metric-label">Harmonized Asset Class</span>
          <span class="metric-value" id="favoredAsset">Bullion &amp; Sovereign Debt</span>
          <p class="metric-desc">Jupiterian and Solar planetary placements favor steady wealth accrual in metals and capital preservation vehicles.</p>
        </div>
      </div>

      <!-- Vimshottari Mahadasha & Antardasha Timeline -->
      <div class="result-metric-box dasha-breakdown-card" id="dashaBreakdownBox">
        <div class="dasha-header">
          <span class="metric-label">Active Planetary Timing (Vimshottari Dasha Engine)</span>
          <span class="dasha-badge" id="birthNakshatraLabel">Birth Nakshatra: Calculating...</span>
        </div>
        <div class="dasha-timelines-grid">
          <div class="dasha-tier-box">
            <span class="tier-label">Current Ruling Mahadasha</span>
            <div class="tier-val" id="mahadashaLord">Lord Rahu</div>
            <span class="tier-dates" id="mahadashaDates">2010 – 2028</span>
            <p class="tier-desc" id="mahadashaDesc">Governs transformative volatility cycles and asymmetric market exposure.</p>
          </div>
          <div class="dasha-tier-box">
            <span class="tier-label">Active Sub-Period (Antardasha)</span>
            <div class="tier-val" id="antardashaLord">Lord Moon (Chandra)</div>
            <span class="tier-dates" id="antardashaDates">2025 – 2027</span>
            <p class="tier-desc">Governs emotional temperament, risk calibration, and short-term liquidity rotations.</p>
          </div>
        </div>
      </div>

      <!-- Detected Classical Dhana & Wealth Yogas -->
      <div class="result-metric-box dhana-yogas-card" id="dhanaYogasBox">
        <div class="dasha-header">
          <div>
            <span class="metric-label">Classical Dhana &amp; Speculative Wealth Yogas</span>
            <div class="dhana-subtitle">Classical wealth combinations detected from Brihat Parasara Hora Sastra &amp; Saravali</div>
          </div>
          <span class="dasha-badge">✦ Classical Vedic Rules</span>
        </div>
        <div class="dhana-yogas-grid" id="dhanaYogasList">
          <!-- Populated dynamically via kundli-form.js -->
        </div>
      </div>

      <!-- ==============================================================
           LARGER-THAN-LIFE CELEBRITY CONSULTATION CARD: DR. ASHISH PATNI
           ============================================================== -->
      <div class="celebrity-consultation-showcase" id="drAshishConsultationCard">
        <div class="consultation-showcase-grid">
          <div class="showcase-photo-frame">
            <img src="/images/dr_ashish_patni_executive.png" alt="Dr. Ashish Patni — Celebrity Financial Astrologer &amp; Master Numerologist" class="showcase-photo">
            <div class="showcase-verified-tag">
              <span class="star-icon">✦</span>
              <span>VIP Financial Astrologer &amp; Numerologist</span>
            </div>
          </div>

          <div class="showcase-details">
            <div class="showcase-badge">EXCLUSIVE 1-ON-1 PERSONAL GUIDANCE</div>
            <h3 class="showcase-doctor-name">Dr. Ashish Patni</h3>
            <div class="showcase-doctor-title">
              Celebrity Financial Astrologer &bull; Master Numerologist &bull; Founder, Bhavishyam (<a href="https://www.bhavishyam.com" target="_blank" rel="noopener">www.bhavishyam.com</a>)
            </div>

            <p class="showcase-copy">
              Your birth coordinates reveal traditional Vedic astrological alignments and wealth yogas. For complete personalized guidance regarding your <strong>multi-asset financial cycles, name numerology harmony, personal Mahadasha timing, and specific transit remedies</strong>, consult directly with <strong>Dr. Ashish Patni</strong>.
            </p>

            <div class="showcase-highlights-row">
              <span class="chip-gold">✓ Multi-Asset Planetary Timing</span>
              <span class="chip-gold">✓ Personal Horoscope Wealth Houses</span>
              <span class="chip-gold">✓ Name &amp; Business Numerology</span>
              <span class="chip-gold">✓ Vimshottari Dasha Remedies</span>
            </div>

            <div class="showcase-cta-group">
              <a href="https://wa.me/<%= founder.whatsappNumber %>?text=<%= encodeURIComponent(whatsappMessage) %>" id="kundliWhatsAppLink" class="btn btn-whatsapp-vip btn-lg" target="_blank" rel="noopener">
                <span class="wa-icon">💬</span>
                <span>Consult VIP Astrologer Dr. Ashish Patni on WhatsApp</span>
              </a>
              <a href="https://www.bhavishyam.com" target="_blank" rel="noopener" class="btn btn-outline btn-lg">
                <span>Visit www.bhavishyam.com</span>
                <span class="btn-arrow">&rarr;</span>
              </a>
            </div>

            <div class="showcase-security-note">
              🔒 100% Confidential Personal Consultation &bull; Trusted by Top Industrialists, Family Offices &amp; Traders Globally
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
