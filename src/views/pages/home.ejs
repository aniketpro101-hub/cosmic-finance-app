  <!-- ==============================================================
       1B. LIVE BILINGUAL DAILY VEDIC PANCHANG (दैनिक पंचांग — हिन्दी डिफॉल्ट)
       ============================================================== -->
  <section class="daily-panchang-section" id="dailyPanchangSection">
    <div class="container">
      <div class="panchang-header-wrapper">
        <div class="panchang-title-meta">
          <div class="panchang-kicker">
            <span class="pulsing-star">✦</span>
            <span class="panchang-hi">दैनिक वैदिक पंचांग एवं वित्तीय मुहूर्त</span>
            <span class="panchang-en hidden-lang">VEDIC MARKET CHRONOMETER</span>
          </div>
          <h2 class="panchang-main-heading">
            <span class="panchang-hi">आज का वित्तीय पंचांग एवं शुभ-अशुभ मुहूर्त</span>
            <span class="panchang-en hidden-lang">Today's Financial Panchang &amp; Muhurat Timing</span>
          </h2>
          <p class="panchang-sub-heading">
            <span class="panchang-hi">मुंबई (BSE / NSE) सौर मेरिडियन द्वारा प्रमाणित &bull; <%= panchang ? panchang.gregorianDateFormatted : istNow.dateFormatted %> (<%= panchang ? panchang.hinduSamvat : 'विक्रम संवत २०८३' %>)</span>
            <span class="panchang-en hidden-lang">Calibrated to Mumbai (BSE / NSE) Solar Meridian &bull; <%= panchang ? panchang.gregorianDateFormatted : istNow.dateFormatted %> (<%= panchang ? panchang.hinduSamvat : 'Vikram Samvat 2083' %>)</span>
          </p>
        </div>

        <!-- Bilingual Switcher Controls (Hindi by default) -->
        <div class="panchang-lang-toggle" role="group" aria-label="Panchang Language Switcher">
          <button type="button" class="panchang-lang-btn active" data-lang="hi">🇮🇳 हिन्दी</button>
          <button type="button" class="panchang-lang-btn" data-lang="en">🇬🇧 English</button>
        </div>
      </div>

      <% if (panchang) { %>
      <!-- Five Limbs of Panchang Grid -->
      <div class="panchang-limbs-grid">
        <!-- 1. Tithi -->
        <div class="panchang-card">
          <div class="p-card-top">
            <span class="p-card-label panchang-hi">तिथि</span>
            <span class="p-card-label panchang-en hidden-lang">TITHI</span>
            <span class="p-badge"><span class="panchang-hi"><%= panchang.tithi.pakshaHi %></span><span class="panchang-en hidden-lang"><%= panchang.tithi.paksha %></span></span>
          </div>
          <div class="p-card-value">
            <span class="panchang-hi"><%= panchang.tithi.nameHi %></span>
            <span class="panchang-en hidden-lang"><%= panchang.tithi.name %></span>
          </div>
          <div class="p-card-meta">
            <span class="panchang-hi">समाप्ति: <%= panchang.tithi.endingTime %></span>
            <span class="panchang-en hidden-lang">Ends: <%= panchang.tithi.endingTime %></span>
          </div>
        </div>

        <!-- 2. Vaar (Day) -->
        <div class="panchang-card">
          <div class="p-card-top">
            <span class="p-card-label panchang-hi">वार (दिन)</span>
            <span class="p-card-label panchang-en hidden-lang">VAAR (DAY)</span>
            <span class="p-dot" style="background: <%= panchang.vaar.rulerColor %>"></span>
          </div>
          <div class="p-card-value">
            <span class="panchang-hi"><%= panchang.vaar.nameHi %></span>
            <span class="panchang-en hidden-lang"><%= panchang.vaar.name %></span>
          </div>
          <div class="p-card-meta">
            <span class="panchang-hi">स्वामी: <strong><%= panchang.vaar.planetHi %></strong></span>
            <span class="panchang-en hidden-lang">Lord: <strong><%= panchang.vaar.planet %></strong></span>
          </div>
        </div>

        <!-- 3. Nakshatra -->
        <div class="panchang-card">
          <div class="p-card-top">
            <span class="p-card-label panchang-hi">नक्षत्र</span>
            <span class="p-card-label panchang-en hidden-lang">NAKSHATRA</span>
            <span class="p-badge p-badge-star">#<%= panchang.nakshatra.number %></span>
          </div>
          <div class="p-card-value">
            <span class="panchang-hi"><%= panchang.nakshatra.nameHi %></span>
            <span class="panchang-en hidden-lang"><%= panchang.nakshatra.name %></span>
          </div>
          <div class="p-card-meta">
            <span class="panchang-hi">स्वामी: <strong><%= panchang.nakshatra.rulerHi %></strong> &bull; <%= panchang.nakshatra.endingTime %></span>
            <span class="panchang-en hidden-lang">Ruler: <strong><%= panchang.nakshatra.ruler %></strong> &bull; <%= panchang.nakshatra.endingTime %></span>
          </div>
        </div>

        <!-- 4. Yoga -->
        <div class="panchang-card">
          <div class="p-card-top">
            <span class="p-card-label panchang-hi">योग</span>
            <span class="p-card-label panchang-en hidden-lang">YOGA</span>
            <span class="p-badge <%= panchang.yoga.nature === 'Auspicious' ? 'p-badge-good' : 'p-badge-warn' %>">
              <span class="panchang-hi"><%= panchang.yoga.natureHi %></span>
              <span class="panchang-en hidden-lang"><%= panchang.yoga.nature %></span>
            </span>
          </div>
          <div class="p-card-value">
            <span class="panchang-hi"><%= panchang.yoga.nameHi %></span>
            <span class="panchang-en hidden-lang"><%= panchang.yoga.name %></span>
          </div>
          <div class="p-card-meta">
            <span class="panchang-hi">२७ नित्य योग क्रम</span>
            <span class="panchang-en hidden-lang">27 Nitya Yoga Matrix</span>
          </div>
        </div>

        <!-- 5. Karana -->
        <div class="panchang-card">
          <div class="p-card-top">
            <span class="p-card-label panchang-hi">करण</span>
            <span class="p-card-label panchang-en hidden-lang">KARANA</span>
            <span class="p-badge <%= panchang.karana.nature === 'Good' ? 'p-badge-good' : 'p-badge-warn' %>">
              <span class="panchang-hi"><%= panchang.karana.natureHi %></span>
              <span class="panchang-en hidden-lang"><%= panchang.karana.nature %></span>
            </span>
          </div>
          <div class="p-card-value">
            <span class="panchang-hi"><%= panchang.karana.nameHi %></span>
            <span class="panchang-en hidden-lang"><%= panchang.karana.name %></span>
          </div>
          <div class="p-card-meta">
            <span class="panchang-hi">अर्ध-तिथि अवधि</span>
            <span class="panchang-en hidden-lang">Half-Tithi Duration</span>
          </div>
        </div>
      </div>

      <!-- Critical Market Muhurat Timing Row (Rahu Kaal vs Abhijit Muhurat) -->
      <div class="panchang-muhurat-row">
        <!-- Rahu Kaal (Caution Window) -->
        <div class="muhurat-timing-card danger-window" id="rahuKaalCard" data-start="<%= panchang.rahuKaal.start %>" data-end="<%= panchang.rahuKaal.end %>">
          <div class="muhurat-card-top">
            <div class="m-title-group">
              <span class="m-icon icon-danger">⚠️</span>
              <div>
                <h3 class="m-card-title panchang-hi"><%= panchang.rahuKaal.labelHi %> (अशुभ / उच्च अस्थिरता काल)</h3>
                <h3 class="m-card-title panchang-en hidden-lang"><%= panchang.rahuKaal.label %> (Inauspicious Window)</h3>
              </div>
            </div>
            <span class="muhurat-badge badge-upcoming" id="rahuKaalStatusBadge">Calculating...</span>
          </div>
          <div class="muhurat-time-range mono-num">
            <%= panchang.rahuKaal.start %> &ndash; <%= panchang.rahuKaal.end %> <span class="tz-label">IST</span>
