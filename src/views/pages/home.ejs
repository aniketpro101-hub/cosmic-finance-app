       ============================================================== -->
  <section class="multi-asset-research-section" id="multiAssetResearchSection">
    <div class="container">
      <div class="multi-asset-card-master">
        <div class="multi-asset-header-tag">
          <span>🌐</span>
          <span>MULTI-ASSET CLASS RESEARCH SCOPE</span>
        </div>
        <blockquote class="multi-asset-primary-statement">
          "Cosmic Finance explores the relationship between planetary transits, Nakshatra movements, Vedic astrology, numerology and historical patterns across multiple asset classes."
        </blockquote>
        <p class="multi-asset-sub-statement">
          Our research extends across equities, precious metals, energy, agricultural commodities, real estate and digital assets.<br>
          Through individual horoscope and name - numerology analysis, we also explore traditional astrological interpretations of financial tendencies, speculation and favourable or challenging periods in a person's life.*
        </p>

        <!-- 6 Multi-Asset Classes Visual Grid -->
        <div class="multi-asset-grid">
          <% if (typeof multiAssetClasses !== 'undefined' && multiAssetClasses.length) { %>
            <% multiAssetClasses.forEach(function(cls) { %>
              <div class="multi-asset-item">
                <div class="asset-icon-sym">
                  <span class="asset-icon"><%= cls.icon %></span>
                  <div>
                    <strong class="asset-title"><%= cls.name %></strong>
                    <div class="asset-scope"><%= cls.symbol %></div>
                  </div>
                </div>
                <p class="asset-desc"><%= cls.desc %></p>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>
    </div>
  </section>

