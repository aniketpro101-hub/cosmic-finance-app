<div class="homepage-root">
  <!-- Unified Responsive Observatory Section -->
  <section class="hero-observatory-section" id="heroObservatory">
    <div class="container hero-container" style="flex-direction: column; align-items: stretch;">
      <div class="hero-headline-block" style="max-width: 920px; margin: 0 auto 12px; text-align: center;">
        <div class="cosmic-badge" style="margin: 0 auto 10px;">
          <span class="pulsing-star">✦</span>
          <span>VEDIC MULTI-ASSET FINANCIAL ASTROLOGY &amp; NUMEROLOGY</span>
        </div>
        <h1 class="hero-title" style="font-size: clamp(1.75rem, 5vw, 3.8rem); margin-top: 6px; margin-bottom: 8px;">
