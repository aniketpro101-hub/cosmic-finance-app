      <div class="floating-hora-top">
        <span class="floating-hora-dot"></span>
        <span class="floating-hora-glyph" id="floatingHoraGlyph"><%= currentHora.glyph %></span>
        <strong class="floating-hora-title" id="floatingHoraTitle"><%= currentHora.label %></strong>
        <span class="floating-hora-clock" id="floatingHoraClock"><%= istNow.timeStrShort %> IST</span>
        <button class="floating-hora-close" id="btnDismissFloatingHora" aria-label="Dismiss planetary hour widget" onclick="document.getElementById('floatingHoraWidget').style.display='none'">&times;</button>
      </div>
      <div class="floating-hora-sub" id="floatingHoraSub">
        <span><%= currentHora.sunrise %> &#8599; <%= currentHora.sunset %> &#8600; next <%= currentHora.nextGlyph %> <%= currentHora.nextPlanet %> &middot; IST</span>
      </div>
    </div>
  </div>
</div>
