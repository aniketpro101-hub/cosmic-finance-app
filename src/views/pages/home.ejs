      <!-- Symmetrical 2x2 Grid of Featured Case Studies -->
      <div class="home-chronicles-grid">
        <% if (typeof featuredChronicles !== 'undefined' && featuredChronicles.length) { %>
          <% featuredChronicles.forEach(function(item) { %>
            <article class="chronicle-card <%= item.isUnbrokenLegend ? 'unbroken-legend-card' : '' %>">
              <div class="chronicle-media-wrap">
                <img 
                  src="<%= item.image %>" 
                  alt="<%= item.name %> — <%= item.moniker %>" 
                  class="chronicle-card-img" 
                  loading="lazy" 
                  onerror="this.src='/images/dr_ashish_patni_executive.png'"
                >
                <div class="chronicle-badge-overlay">
                  <% if (item.isUnbrokenLegend) { %>
                    <span class="c-legend-badge">★ THE UNBROKEN LEGEND</span>
                  <% } else { %>
                    <span class="c-era-badge"><%= item.era %></span>
                    <span class="c-category-badge"><%= item.category %></span>
                  <% } %>
                </div>
                <div class="chronicle-asset-pill">
                  <span><%= item.assetClass %></span>
                </div>
              </div>

              <div class="chronicle-card-body">
                <h3 class="chronicle-card-title">
                  <a href="/chronicles/<%= item.slug %>"><%= item.name %></a>
                </h3>
                <div class="chronicle-moniker <%= item.isUnbrokenLegend ? 'text-gold' : '' %>"><%= item.moniker %></div>
                <p class="chronicle-tagline">"<%= item.tagline %>"</p>

                <div class="chronicle-astro-preview">
                  <div class="astro-p-row">
                    <span class="p-kicker">🪐 Cosmic Yoga:</span>
                    <span class="p-desc text-gold"><%= item.astrologicalBlueprint.wealthYoga %></span>
                  </div>
                  <div class="astro-p-row">
                    <% if (item.isUnbrokenLegend) { %>
                      <span class="p-kicker">🛡️ Planetary Shield:</span>
                      <span class="p-desc text-green"><%= item.astrologicalBlueprint.fallTrigger %></span>
                    <% } else { %>
                      <span class="p-kicker">⚡ Turning Point:</span>
                      <span class="p-desc text-red"><%= item.astrologicalBlueprint.fallTrigger %></span>
                    <% } %>
                  </div>
                </div>

                <div class="chronicle-quantum-grid">
                  <div class="quantum-item">
                    <span class="q-label">Peak Asset Valuation</span>
                    <strong class="q-val text-green"><%= item.peakNetWorth %></strong>
                  </div>
                  <div class="quantum-item">
                    <% if (item.isUnbrokenLegend) { %>
                      <span class="q-label">Capital Preservation</span>
                      <strong class="q-val text-gold">100% Unbroken Record</strong>
                    <% } else { %>
                      <span class="q-label">Exposure / Downfall</span>
                      <strong class="q-val text-red"><%= item.fallQuantum %></strong>
                    <% } %>
                  </div>
                </div>

                <div class="chronicle-card-footer">
                  <span class="astro-tag">📜 <%= item.isUnbrokenLegend ? 'Legend Astrological Study' : 'Astrological Deconstruction' %></span>
                  <a href="/chronicles/<%= item.slug %>" class="btn btn-outline btn-xs <%= item.isUnbrokenLegend ? 'btn-legend-gold' : '' %>">
                    <span>Read Blueprint &rarr;</span>
                  </a>
                </div>
              </div>
            </article>
          <% }); %>
        <% } %>
      </div>
    </div>
  </section>

