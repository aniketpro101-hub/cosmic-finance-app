  <!-- Interactive Language Switcher Script -->
  <script>
    function switchLanguage(lang) {
      document.body.setAttribute('data-lang', lang);
      
      const btnHi = document.getElementById('btnLangHi');
      const btnEn = document.getElementById('btnLangEn');

      if (lang === 'hi') {
        btnHi.classList.add('active');
        btnEn.classList.remove('active');
      } else {
        btnEn.classList.add('active');
        btnHi.classList.remove('active');
      }

      try {
        localStorage.setItem('cf_report_lang', lang);
      } catch(e) {}
    }

    // Initialize from storage or default to Hindi
    document.addEventListener('DOMContentLoaded', function() {
      try {
        const saved = localStorage.getItem('cf_report_lang');
        if (saved === 'en') {
          switchLanguage('en');
        } else {
          switchLanguage('hi');
        }
      } catch(e) {
        switchLanguage('hi');
      }
    });
  </script>
