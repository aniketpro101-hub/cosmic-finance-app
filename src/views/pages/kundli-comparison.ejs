<script>
document.addEventListener('DOMContentLoaded', function() {
  const tabBtns = document.querySelectorAll('.client-tab-btn');
  const panels = document.querySelectorAll('.client-panel');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      const clientId = this.getAttribute('data-client');

      tabBtns.forEach(b => b.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));

      this.classList.add('active');
      const targetPanel = document.getElementById('panel-' + clientId);
      if (targetPanel) {
        targetPanel.classList.add('active');
      }
    });
  });
});
</script>
